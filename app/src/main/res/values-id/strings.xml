    <!-- User Guide Strings -->
    <string name="guide_title">Panduan Pengguna (User Guide)</string>
    <string name="guide_subtitle">Cara Menggunakan Aplikasi</string>
    <string name="guide_step_1_title">1. Cara Melakukan Panggilan Palsu</string>
    <string name="guide_step_1_desc">Pilih pemain bola idola Anda dari daftar, pilih gaya template (WA, IG, atau TG), pilih Panggilan Suara atau Video, atur timer (Panggil Sekarang atau Delay), lalu tekan tombol \'Mulai Simulasi Panggilan\'.</string>

    <string name="guide_step_2_title">2. Cara Menambah Pemain Kustom Anda</string>
    <string name="guide_step_2_desc">Tekan kartu \'Add Custom (+)\' di ujung daftar pemain. Tonton iklan video singkat hingga selesai untuk membuka fitur ini. Masukkan nama pemain, pilih foto profil, dan pilih file video MP4 dari galeri HP Anda.</string>

    <string name="guide_step_3_title">3. Cara Menggeser Kamera Depan</string>
    <string name="guide_step_3_desc">Saat panggilan video terhubung, sentuh dan geser kotak pratinjau kamera depan Anda ke sudut mana saja di layar secara bebas.</string>

    <string name="guide_step_4_title">4. Cara Memasang Wallpaper</string>
    <string name="guide_step_4_desc">Buka tab Wallpaper, pilih gambar atau video pilihan Anda, lalu tekan \'Pasang Sebagai Wallpaper\' untuk memasang di Layar Utama, Layar Kunci, atau Keduanya.</string>

